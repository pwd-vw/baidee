{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baidee.local/contracts/payload.schema.json",
  "title": "BaiDee Capture Payload",
  "type": "object",
  "required": ["schema_version", "capture_id", "node_id", "site_id", "bed_id", "timestamp", "image_sha256", "image_size", "stage"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "capture_id": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z_bd-[a-z0-9-]+$"},
    "node_id": {"type": "string", "pattern": "^bd-[a-z0-9-]+$"},
    "site_id": {"type": "string", "pattern": "^s[0-9]{2}$"},
    "bed_id": {"type": "string", "pattern": "^b[0-9]{2}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "image_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image_size": {"type": "object", "required": ["w", "h"], "properties": {"w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "stage": {"enum": ["edge_triage", "pi_verify", "manual"]}
  },
  "additionalProperties": true
}
